# Copy to .env.local (never commit real values)

# Public URL used for links and QR codes
NEXT_PUBLIC_BASE_URL=https://moradoksiang.kamnuantech.com

# Where app.db and audio files live (gitignored)
DATA_DIR=./data

# Book token of the demo life book shown on the landing page (from `npm run seed:demo`)
DEMO_BOOK_TOKEN=

# Natural Thai voice for questions the grandchild hasn't recorded (Google Cloud Text-to-Speech).
# Only question text is sent; leave empty to use the browser's voice.
# Restrict the key to "Cloud Text-to-Speech API" in Google Cloud Console.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=th-TH-Neural2-C
GOOGLE_TTS_RATE=0.9

# Set to "off" if the transcription worker is not running
TRANSCRIBE=on

# Transcription worker (worker/transcribe.py)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8
